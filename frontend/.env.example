# ==============================================================================
# Terra360 Frontend Environment Variables Example (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NOTE: Variables prefixed with NEXT_PUBLIC_ are exposed to the client browser.
# NEVER place backend secrets, private keys, or database credentials here.
# ==============================================================================

# Backend API Base URL
# - Local Development: http://localhost:5000
# - Vercel Production: https://your-backend-api.onrender.com (or custom API domain)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: Cloudflare Turnstile Development Captcha Token (Local Dev/Testing Only)
# Leave blank in production.
# NEXT_PUBLIC_DEV_CAPTCHA_TOKEN=

# Mapbox Public Access Token (for Interactive Mapbox GL components)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_access_token


