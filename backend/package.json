{
  "name": "terra360-backend",
  "version": "1.0.0",
  "description": "Terra360 Landslide Early-Warning Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "init:collections": "tsx src/scripts/init-collections.ts",
    "test": "tsx src/tests/auth.test.ts",
    "test:models": "tsx src/tests/models.test.ts",
    "test:public": "tsx src/tests/public.test.ts",
    "test:write": "tsx src/tests/public-write.test.ts",
    "test:postman": "npx --yes newman run postman/collection.json -e postman/environment.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.0",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
